# Dummy API (default). Set to "false" and provide NEXT_PUBLIC_API_URL to talk to a real backend.
NEXT_PUBLIC_USE_DUMMY_API=true
NEXT_PUBLIC_API_URL=https://api.example.com/v1

# Artificial latency for the dummy API (ms)
NEXT_PUBLIC_DUMMY_LATENCY_MIN=250
NEXT_PUBLIC_DUMMY_LATENCY_MAX=600

# Domain shown for generated website addresses
NEXT_PUBLIC_BASE_DOMAIN=ryugaware.com
