// =============================================================================
// Ryugaware — dbdiagram.io source
// Paste into https://dbdiagram.io/d   (Import > DBML, or just paste in the editor)
//
// REVISION 2 — changes requested after the first review:
//   * customers now holds its JWT signing secret as columns; customer_jwt_secrets is gone.
//     Consequence to accept: rotation invalidates live tokens, because only one secret exists
//     at a time (the retired table existed to keep the previous secret valid during a grace
//     window). Revisit if token churn on rotation becomes a problem.
//   * licences -> customer_access: subscription limits, max_websites and max_users_per_website
//     (default 1 website, 50 unique users per website).
//   * website_type enum replaces the ecommerce/services pair: ecommerce, food_delivery,
//     delivery, service, static.
//   * Commerce tables renamed to a generic vocabulary so one set of tables serves every
//     website type: products -> listings, product_variants -> listing_variants,
//     product_images -> listing_images, product_categories -> listing_categories,
//     inventory -> listing_inventory, product_reviews -> reviews. Orders, carts and
//     payments were already generic.
//   * Localisation defaults (language, timezone, currency) stay on customers; websites inherit.
//   * OPEN: "map this to a dashboard as a table" was not clear enough to implement — see the
//     note on customers below.
//
// Mirrors docs/database/schema-design.md §22 (that document still describes revision 1 for the
// areas changed above). Two notes on fidelity:
//   1. The Enum blocks below render nicely in dbdiagram; the real schema uses
//      TEXT + CHECK constraints instead (see §3.3 for why).
//   2. Partial unique indexes (WHERE clauses) cannot be expressed in DBML.
//      They are written as comments where they matter.
// =============================================================================

// ---------------------------------------------------------------- enums ----
Enum customer_status {
  active
  suspended
  closed
}

Enum user_scope {
  platform
  customer
}

Enum dashboard_user_status {
  invited
  active
  suspended
}

Enum access_status {
  active
  expired
  suspended
}

Enum dashboard_token_purpose {
  email_verification
  password_reset
  invitation
}

Enum website_token_purpose {
  email_verification
  password_reset
}

Enum website_type {
  ecommerce
  food_delivery
  delivery
  service
  static
}

Enum template_status {
  draft
  published
  retired
}

Enum template_version_status {
  draft
  released
  deprecated
}

Enum page_kind {
  content
  system
}

Enum page_governed_by {
  sign_in
}

Enum website_status {
  draft
  live
  paused
}

Enum storage_mode {
  platform
  connected
}

Enum section_scope {
  page
  chrome
}

Enum font_pair {
  serif
  sans
}

Enum domain_type {
  platform_subdomain
  custom
}

Enum domain_verification_status {
  pending_dns
  verifying
  active
  failed
}

Enum ssl_status {
  none
  pending
  issued
  failed
}

Enum website_user_status {
  active
  blocked
  unverified
}

Enum identity_provider {
  google
}

Enum storage_status {
  not_connected
  connected
  failed
}

Enum storage_provider {
  s3
  s3_compatible
}

Enum payment_type {
  card
  upi
  netbanking
  wallet
  cod
}

Enum delivery_type {
  standard
  express
  same_day
  pickup
}

Enum rate_type {
  flat
  free
  free_above
}

Enum coverage_type {
  all_india
  metro
  states
  pincodes
}

Enum listing_status {
  draft
  active
  archived
}

Enum cart_status {
  open
  converted
  abandoned
}

Enum coupon_kind {
  percent
  fixed
}

Enum order_status {
  placed
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

Enum order_payment_status {
  pending
  paid
  failed
  cod_due
  refunded
}

Enum payment_status {
  pending
  succeeded
  failed
  refunded
}

Enum refund_status {
  pending
  succeeded
  failed
}

Enum shipment_status {
  processing
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

Enum shipment_event_code {
  placed
  packed
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

Enum shipment_event_source {
  carrier
  manual
  system
}

Enum review_status {
  pending
  published
  rejected
}

Enum newsletter_status {
  subscribed
  unsubscribed
}

Enum actor_type {
  dashboard_user
  website_user
  system
  api
}

Enum order_actor_type {
  system
  dashboard_user
  website_user
}

Enum address_kind {
  shipping
  billing
}

// ================================================================ tenant ====

Table customers {
  id               uuid [pk]
  name             text [not null]
  slug             text [not null, unique]
  status           customer_status [not null, default: 'active']
  default_language text [not null, default: 'en', note: 'platform default; websites inherit it']
  default_timezone text [not null, default: 'Asia/Kolkata']
  default_currency char(3) [not null, default: 'INR']
  jwt_secret_ciphertext bytea [note: 'encrypted with the master key; signs this tenant website-user tokens']
  jwt_key_version       int [note: 'which master key wrapped it']
  jwt_secret_rotated_at timestamptz
  created_at       timestamptz [not null]
  updated_at       timestamptz [not null]

  Note: 'The tenant. Called Organization in the dashboard. Holds its own JWT signing secret as a column. OPEN QUESTION: what should be mapped to a dashboard table here?'
}

Table customer_access {
  id                    uuid [pk]
  customer_id           uuid [not null, unique]
  plan_code             text [not null, default: 'starter']
  status                access_status [not null, default: 'active']
  max_websites          int [not null, default: 1, note: 'websites this subscription allows']
  max_users_per_website int [not null, default: 50, note: 'unique signed-up users per website']
  valid_until           timestamptz [note: 'NULL = perpetual']
  created_at            timestamptz [not null]
  updated_at            timestamptz [not null]

  Note: 'Subscription limits for one tenant. Usage is COUNT(*) over websites and website_users, never a stored counter.'
}

// ================================================== dashboard identity ====

Table dashboard_users {
  id                  uuid [pk]
  customer_id         uuid [note: 'NULL = platform staff']
  scope               user_scope [not null]
  email               citext [not null, unique]
  full_name           text [not null]
  password_hash       text [note: 'Argon2id PHC string']
  password_changed_at timestamptz
  status              dashboard_user_status [not null, default: 'invited']
  email_verified_at   timestamptz
  token_version       int [not null, default: 0]
  last_login_at       timestamptz
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]

  indexes { (id, customer_id) [unique, name: 'uq_dashboard_users_id_customer'] }
  Note: 'CHECK: platform => customer_id IS NULL, customer => NOT NULL.'
}

Table dashboard_refresh_tokens {
  id                uuid [pk]
  dashboard_user_id uuid [not null]
  token_hash        bytea [not null, unique, note: 'SHA-256, never plaintext']
  family_id         uuid [not null]
  replaced_by_id    uuid
  issued_at         timestamptz [not null]
  expires_at        timestamptz [not null]
  revoked_at        timestamptz
  revoked_reason    text
  user_agent        text
  ip                inet
  last_used_at      timestamptz

  Note: 'Also powers the device-session list in Settings.'
}

Table dashboard_user_tokens {
  id                uuid [pk]
  dashboard_user_id uuid [not null]
  purpose           dashboard_token_purpose [not null]
  token_hash        bytea [not null, unique]
  expires_at        timestamptz [not null]
  consumed_at       timestamptz
  created_at        timestamptz [not null]
}

// ========================================================= authorization ====

Table privileges {
  id          bigint [pk, increment]
  code        text [not null, unique, note: 'website.publish — code refers to this']
  module      text [not null]
  description text [not null]
  scope       user_scope [not null]

  indexes { (id, scope) [unique, name: 'uq_privileges_id_scope'] }
}

Table roles {
  id          bigint [pk, increment, note: '1 = SuperAdmin, 2 = Admin']
  "key"       text [not null, unique]
  name        text [not null]
  description text [not null]
  scope       user_scope [not null]
  is_system   boolean [not null, default: false]
  customer_id uuid [note: 'NULL for system roles']
  created_at  timestamptz [not null]
  updated_at  timestamptz [not null]

  indexes {
    (id, scope) [unique, name: 'uq_roles_id_scope']
    (id, customer_id) [unique, name: 'uq_roles_id_customer']
  }
}

Table role_privileges {
  role_id      bigint [not null]
  privilege_id bigint [not null]
  scope        user_scope [not null, note: 'must match both sides']

  indexes { (role_id, privilege_id) [pk] }
  Note: 'Composite FKs on (role_id, scope) and (privilege_id, scope) stop a customer role holding a platform privilege.'
}

Table dashboard_user_roles {
  dashboard_user_id uuid [not null]
  role_id           bigint [not null]
  customer_id       uuid [note: 'grant tenant; NULL only for platform roles']
  website_id        uuid [note: 'NULL = all websites of that customer']
  granted_by        uuid
  granted_at        timestamptz [not null]

  Note: 'Partial unique indexes cover the website_id NULL and NOT NULL cases.'
}

// ============================================================== templates ====

Table templates {
  id                uuid [pk]
  slug              text [not null, unique]
  name              text [not null]
  tagline           text [not null]
  description       text [not null]
  category          website_type [not null]
  status            template_status [not null, default: 'draft']
  preview_image_url text
  created_at        timestamptz [not null]
  updated_at        timestamptz [not null]
}

Table template_versions {
  id            uuid [pk]
  template_id   uuid [not null]
  version       text [not null]
  status        template_version_status [not null, default: 'draft']
  manifest_json jsonb [not null, note: 'field schemas the editor builds forms from']
  preset_json   jsonb [not null, note: 'default content copied at website creation']
  released_at   timestamptz
  created_at    timestamptz [not null]
  updated_at    timestamptz [not null]

  indexes { (template_id, version) [unique] }
}

Table template_pages {
  id                  uuid [pk]
  template_version_id uuid [not null]
  page_key            text [not null]
  path                text [not null]
  label               text [not null]
  description         text [not null]
  kind                page_kind [not null]
  is_required         boolean [not null, default: false]
  required_reason     text
  governed_by         page_governed_by [note: 'sign_in: account pages follow the setting']
  position            int [not null]
  fields_schema       jsonb [not null]
  allowed_sections    "text[]" [not null]

  indexes {
    (template_version_id, page_key) [unique]
    (template_version_id, path) [unique]
    (id, template_version_id) [unique, name: 'uq_template_pages_id_version']
  }
}

Table template_sections {
  id                  uuid [pk]
  template_version_id uuid [not null]
  section_type        text [not null]
  label               text [not null]
  description         text [not null]
  is_chrome           boolean [not null, default: false]
  fields_schema       jsonb [not null]

  indexes {
    (template_version_id, section_type) [unique]
    (id, template_version_id) [unique, name: 'uq_template_sections_id_version']
  }
}

Table template_page_sections {
  id                    uuid [pk]
  template_version_id   uuid [not null]
  template_page_id      uuid [not null]
  template_section_id   uuid [not null]
  position              int [not null]
  is_enabled_by_default boolean [not null, default: true]
  default_settings      jsonb [not null]

  indexes { (template_page_id, position) [unique] }
  Note: 'The preset layout. Composite FKs keep page and section on the same template version.'
}

// =============================================================== websites ====

Table websites {
  id                   uuid [pk]
  customer_id          uuid [not null]
  template_version_id  uuid [not null, note: 'pinned: template releases never move a live site']
  name                 text [not null]
  subdomain            text [not null, unique]
  type                 website_type [not null]
  status               website_status [not null, default: 'draft']
  published_version_id uuid [note: 'NULL = never published']
  storage_mode         storage_mode [not null, default: 'connected']
  last_published_at    timestamptz
  created_at           timestamptz [not null]
  updated_at           timestamptz [not null]

  indexes { (id, customer_id) [unique, name: 'uq_websites_id_customer'] }
  Note: 'Anchor of every tenant chain.'
}

Table media_assets {
  id           uuid [pk]
  customer_id  uuid [not null]
  website_id   uuid [note: 'NULL = shared across the tenant']
  storage_mode storage_mode [not null]
  object_key   text [not null]
  mime_type    text [not null]
  size_bytes   bigint [not null]
  width        int
  height       int
  alt_text     text [not null]
  checksum     bytea
  created_at   timestamptz [not null]

  indexes { (customer_id, storage_mode, object_key) [unique] }
}

Table website_settings {
  website_id       uuid [pk]
  description      text [not null]
  locale           text [not null, note: 'inherited from customers.default_language at creation']
  timezone         text [not null, note: 'inherited from customers.default_timezone']
  currency         char(3) [not null]
  favicon_media_id uuid
  settings         jsonb [not null]
  created_at       timestamptz [not null]
  updated_at       timestamptz [not null]
}

Table website_themes {
  website_id        uuid [pk]
  brand_name        text [not null]
  brand_description text [not null]
  logo_media_id     uuid
  primary_color     text [not null]
  secondary_color   text [not null]
  font_pair         font_pair [not null]
  settings          jsonb [not null, note: 'template-declared theme fields']
  created_at        timestamptz [not null]
  updated_at        timestamptz [not null]
}

Table website_pages {
  id               uuid [pk]
  website_id       uuid [not null]
  template_page_id uuid [note: 'provenance; SET NULL if the definition retires']
  page_key         text [not null]
  path             text [not null]
  title            text [not null]
  kind             page_kind [not null]
  is_enabled       boolean [not null, default: true]
  position         int [not null]
  seo              jsonb [not null]
  settings         jsonb [not null, note: 'values for a system page fields']
  created_at       timestamptz [not null]
  updated_at       timestamptz [not null]

  indexes {
    (website_id, page_key) [unique]
    (website_id, path) [unique]
    (id, website_id) [unique, name: 'uq_website_pages_id_website']
  }
  Note: 'The customer-owned copy. Never shared between websites.'
}

Table website_sections {
  id                  uuid [pk]
  website_id          uuid [not null]
  website_page_id     uuid [note: 'NULL for site chrome']
  scope               section_scope [not null]
  template_section_id uuid
  section_type        text [not null]
  position            int [not null]
  is_enabled          boolean [not null, default: true]
  settings            jsonb [not null, note: 'the editable content of this instance']
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]

  indexes { (website_page_id, position) [unique] }
  Note: 'Composite FK to website_pages(id, website_id) is the editor isolation guarantee. Partial unique (website_id, section_type) WHERE scope=chrome.'
}

Table site_versions {
  id                  uuid [pk]
  website_id          uuid [not null]
  number              int [not null]
  snapshot_json       jsonb [not null, note: 'whole resolved website, immutable']
  template_version_id uuid [not null]
  "note"              text
  published_by        uuid
  created_at          timestamptz [not null]

  indexes {
    (website_id, number) [unique]
    (id, website_id) [unique, name: 'uq_site_versions_id_website']
  }
  Note: 'Publish = insert here + repoint websites.published_version_id. Rollback = one row update.'
}

// ================================================================ domains ====

Table domains {
  id                  uuid [pk]
  website_id          uuid [not null]
  customer_id         uuid [not null]
  hostname            text [not null, unique, note: 'platform-wide ownership']
  domain_type         domain_type [not null]
  verification_status domain_verification_status [not null, default: 'pending_dns']
  verification_token  text
  dns_records         jsonb [not null, note: 'last check: required records and found flags']
  ssl_status          ssl_status [not null, default: 'none']
  ssl_expires_at      timestamptz
  is_primary          boolean [not null, default: false]
  failure_reason      text
  last_checked_at     timestamptz
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]

  Note: 'Partial unique (website_id) WHERE is_primary.'
}

// ========================================================= website users ====

Table website_users {
  id                  uuid [pk]
  website_id          uuid [not null]
  customer_id         uuid [not null]
  email               citext [not null]
  full_name           text [not null]
  phone               text
  password_hash       text [note: 'NULL when Google-only']
  password_changed_at timestamptz
  status              website_user_status [not null, default: 'unverified']
  email_verified_at   timestamptz
  avatar_media_id     uuid
  token_version       int [not null, default: 0]
  marketing_opt_in    boolean [not null, default: false]
  last_active_at      timestamptz
  deleted_at          timestamptz [note: 'soft delete: orders must still render']
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]

  indexes {
    (website_id, email) [unique, name: 'uq_website_users_website_email']
    (id, website_id) [unique, name: 'uq_website_users_id_website']
  }
  Note: 'Shoppers. Same email may exist on another website as a separate account. Counted against customer_access.max_users_per_website.'
}

Table website_user_identities {
  id               uuid [pk]
  website_user_id  uuid [not null]
  website_id       uuid [not null]
  provider         identity_provider [not null]
  provider_subject text [not null, note: 'Google sub, not the email']
  email_at_link    citext
  created_at       timestamptz [not null]

  indexes { (website_id, provider, provider_subject) [unique] }
}

Table website_user_addresses {
  id              uuid [pk]
  website_user_id uuid [not null]
  website_id      uuid [not null]
  label           text [not null]
  recipient_name  text [not null]
  phone           text [not null]
  line1           text [not null]
  line2           text [not null]
  city            text [not null]
  state           text [not null]
  pincode         text [not null]
  country         char(2) [not null]
  is_default      boolean [not null, default: false]
  created_at      timestamptz [not null]
  updated_at      timestamptz [not null]

  Note: 'Partial unique (website_user_id) WHERE is_default.'
}

Table website_refresh_tokens {
  id              uuid [pk]
  website_user_id uuid [not null]
  website_id      uuid [not null]
  token_hash      bytea [not null, unique]
  family_id       uuid [not null]
  replaced_by_id  uuid
  issued_at       timestamptz [not null]
  expires_at      timestamptz [not null]
  revoked_at      timestamptz
  revoked_reason  text
  user_agent      text
  ip              inet
  last_used_at    timestamptz
}

Table website_user_tokens {
  id              uuid [pk]
  website_user_id uuid [not null]
  website_id      uuid [not null]
  purpose         website_token_purpose [not null]
  token_hash      bytea [not null, unique]
  expires_at      timestamptz [not null]
  consumed_at     timestamptz
  created_at      timestamptz [not null]
}

// ======================================= organisation config + overrides ====

Table customer_auth_settings {
  customer_id                     uuid [pk]
  email_enabled                   boolean [not null]
  email_allow_signups             boolean [not null]
  email_require_verification      boolean [not null]
  email_min_password_length       int [not null]
  session_days                    int [not null]
  google_enabled                  boolean [not null]
  google_client_id                text [not null]
  google_client_secret_ciphertext bytea
  google_key_version              int
  google_allowed_domains          "text[]" [not null]
  created_at                      timestamptz [not null]
  updated_at                      timestamptz [not null]
}

Table website_auth_settings {
  website_id                      uuid [pk]
  customer_id                     uuid [not null]
  email_enabled                   boolean [not null]
  email_allow_signups             boolean [not null]
  email_require_verification      boolean [not null]
  email_min_password_length       int [not null]
  session_days                    int [not null]
  google_enabled                  boolean [not null]
  google_client_id                text [not null]
  google_client_secret_ciphertext bytea
  google_key_version              int
  google_allowed_domains          "text[]" [not null]
  created_at                      timestamptz [not null]
  updated_at                      timestamptz [not null]

  Note: 'Row present = this website overrides the customer default.'
}

Table customer_contact_details {
  customer_id          uuid [pk]
  business_name        text [not null]
  contact_person       text [not null]
  support_email        citext [not null]
  phone                text [not null]
  whatsapp             text [not null]
  support_hours        text [not null]
  line1                text [not null]
  line2                text [not null]
  city                 text [not null]
  state                text [not null]
  pincode              text [not null]
  show_in_footer       boolean [not null]
  show_on_contact_page boolean [not null]
  show_on_invoices     boolean [not null]
  created_at           timestamptz [not null]
  updated_at           timestamptz [not null]
}

Table website_contact_details {
  website_id           uuid [pk]
  customer_id          uuid [not null]
  business_name        text [not null]
  contact_person       text [not null]
  support_email        citext [not null]
  phone                text [not null]
  whatsapp             text [not null]
  support_hours        text [not null]
  line1                text [not null]
  line2                text [not null]
  city                 text [not null]
  state                text [not null]
  pincode              text [not null]
  show_in_footer       boolean [not null]
  show_on_contact_page boolean [not null]
  show_on_invoices     boolean [not null]
  created_at           timestamptz [not null]
  updated_at           timestamptz [not null]
}

Table storage_configs {
  customer_id       uuid [pk]
  provider          storage_provider [not null]
  endpoint          text [not null]
  bucket            text [not null]
  region            text [not null]
  access_key_id     text [not null]
  secret_ciphertext bytea
  key_version       int
  path_prefix       text [not null]
  public_base_url   text [not null]
  force_path_style  boolean [not null]
  status            storage_status [not null, default: 'not_connected']
  last_test         jsonb
  connected_at      timestamptz
  created_at        timestamptz [not null]
  updated_at        timestamptz [not null]
}

Table payment_methods {
  id                    uuid [pk]
  customer_id           uuid [not null]
  type                  payment_type [not null]
  provider              text [not null]
  display_name          text [not null]
  enabled               boolean [not null, default: true]
  test_mode             boolean [not null, default: false]
  fee_percent           numeric(5,2) [not null]
  fee_fixed             numeric(12,2) [not null]
  min_order             numeric(12,2)
  max_order             numeric(12,2)
  key_id                text [note: 'not secret, shown masked']
  key_secret_ciphertext bytea
  key_version           int
  applies_to_all        boolean [not null, default: true]
  created_at            timestamptz [not null]
  updated_at            timestamptz [not null]

  indexes { (id, customer_id) [unique, name: 'uq_payment_methods_id_customer'] }
}

Table payment_method_websites {
  payment_method_id uuid [not null]
  website_id        uuid [not null]
  customer_id       uuid [not null]
  created_at        timestamptz [not null]

  indexes { (payment_method_id, website_id) [pk] }
  Note: 'Rows exist only when applies_to_all = false. Both sides pinned to the same customer.'
}

Table delivery_methods {
  id             uuid [pk]
  customer_id    uuid [not null]
  name           text [not null]
  type           delivery_type [not null]
  carrier        text [not null]
  min_days       int [not null]
  max_days       int [not null]
  rate_type      rate_type [not null]
  price          numeric(12,2) [not null]
  free_above     numeric(12,2)
  coverage       coverage_type [not null]
  regions        "text[]" [not null]
  enabled        boolean [not null, default: true]
  applies_to_all boolean [not null, default: true]
  created_at     timestamptz [not null]
  updated_at     timestamptz [not null]

  indexes { (id, customer_id) [unique, name: 'uq_delivery_methods_id_customer'] }
}

Table delivery_method_websites {
  delivery_method_id uuid [not null]
  website_id         uuid [not null]
  customer_id        uuid [not null]
  created_at         timestamptz [not null]

  indexes { (delivery_method_id, website_id) [pk] }
}

// ============================================================== catalogue ====

Table listing_categories {
  id             uuid [pk]
  website_id     uuid [not null]
  slug           text [not null]
  name           text [not null]
  blurb          text [not null]
  image_media_id uuid
  position       int [not null]
  created_at     timestamptz [not null]
  updated_at     timestamptz [not null]

  indexes {
    (website_id, slug) [unique]
    (id, website_id) [unique, name: 'uq_listing_categories_id_website']
  }
}

Table listings {
  id               uuid [pk]
  website_id       uuid [not null]
  slug             text [not null]
  name             text [not null]
  summary          text [not null]
  description      text [not null]
  status           listing_status [not null, default: 'draft']
  base_price       numeric(12,2) [not null]
  compare_at_price numeric(12,2)
  specs            jsonb [not null]
  rating_avg       numeric(2,1) [not null, note: 'denormalised for listing sort']
  review_count     int [not null]
  deleted_at       timestamptz [note: 'soft delete: order lines reference it']
  created_at       timestamptz [not null]
  updated_at       timestamptz [not null]

  indexes {
    (website_id, slug) [unique]
    (id, website_id) [unique, name: 'uq_listings_id_website']
  }
}

Table listing_variants {
  id          uuid [pk]
  listing_id  uuid [not null]
  website_id  uuid [not null]
  label       text [not null]
  sku         text
  price_delta numeric(12,2) [not null]
  is_active   boolean [not null, default: true]
  deleted_at  timestamptz
  created_at  timestamptz [not null]
  updated_at  timestamptz [not null]

  indexes {
    (website_id, sku) [unique]
    (id, website_id) [unique, name: 'uq_listing_variants_id_website']
  }
}

Table listing_images {
  id             uuid [pk]
  listing_id     uuid [not null]
  website_id     uuid [not null]
  media_asset_id uuid [not null]
  position       int [not null]
}

Table listing_category_mappings {
  listing_id          uuid [not null]
  listing_category_id uuid [not null]
  website_id          uuid [not null]

  indexes { (listing_id, listing_category_id) [pk] }
}

Table listing_inventory {
  listing_variant_id uuid [pk]
  website_id         uuid [not null]
  on_hand            int [not null]
  reserved           int [not null]
  updated_at         timestamptz [not null]
}

// =================================================================== cart ====

Table carts {
  id               uuid [pk]
  website_id       uuid [not null]
  website_user_id  uuid
  guest_token_hash bytea
  status           cart_status [not null, default: 'open']
  currency         char(3) [not null]
  expires_at       timestamptz
  created_at       timestamptz [not null]
  updated_at       timestamptz [not null]

  indexes { (id, website_id) [unique, name: 'uq_carts_id_website'] }
  Note: 'CHECK: exactly one of website_user_id / guest_token_hash. Partial unique open cart per user.'
}

Table cart_items {
  id                 uuid [pk]
  cart_id            uuid [not null]
  website_id         uuid [not null]
  listing_id         uuid [not null]
  listing_variant_id uuid [not null]
  quantity           int [not null]
  unit_price         numeric(12,2) [not null]
  created_at         timestamptz [not null]
  updated_at         timestamptz [not null]

  indexes { (cart_id, listing_variant_id) [unique] }
}

// ============================================================== discounts ====

Table coupons {
  id              uuid [pk]
  website_id      uuid [not null]
  code            text [not null]
  kind            coupon_kind [not null]
  value           numeric(12,2) [not null]
  min_order_total numeric(12,2)
  max_redemptions int
  per_user_limit  int
  starts_at       timestamptz
  ends_at         timestamptz
  is_active       boolean [not null, default: true]
  created_at      timestamptz [not null]
  updated_at      timestamptz [not null]

  indexes { (id, website_id) [unique, name: 'uq_coupons_id_website'] }
  Note: 'Unique index on (website_id, upper(code)).'
}

Table coupon_redemptions {
  id                uuid [pk]
  coupon_id         uuid [not null]
  website_id        uuid [not null]
  order_id          uuid [not null]
  website_user_id   uuid
  amount_discounted numeric(12,2) [not null]
  created_at        timestamptz [not null]

  indexes { (coupon_id, order_id) [unique] }
}

// ================================================================= orders ====

Table orders {
  id                    uuid [pk]
  website_id            uuid [not null]
  customer_id           uuid [not null]
  order_number          text [not null]
  website_user_id       uuid [note: 'NULL = guest checkout']
  contact_email         citext [not null]
  contact_phone         text [not null]
  status                order_status [not null, default: 'placed']
  payment_status        order_payment_status [not null, default: 'pending']
  currency              char(3) [not null]
  subtotal              numeric(12,2) [not null]
  shipping_total        numeric(12,2) [not null]
  discount_total        numeric(12,2) [not null]
  tax_total             numeric(12,2) [not null]
  grand_total           numeric(12,2) [not null]
  delivery_method_id    uuid
  payment_method_id     uuid
  placed_at             timestamptz [not null]
  estimated_delivery_at timestamptz
  created_at            timestamptz [not null]
  updated_at            timestamptz [not null]

  indexes {
    (website_id, order_number) [unique]
    (id, website_id) [unique, name: 'uq_orders_id_website']
  }
}

Table order_items {
  id                 uuid [pk]
  order_id           uuid [not null]
  website_id         uuid [not null]
  listing_id         uuid
  listing_variant_id uuid
  listing_name       text [not null, note: 'copied at purchase time']
  variant_label      text [not null]
  image_media_id     uuid
  unit_price         numeric(12,2) [not null]
  quantity           int [not null]
  line_total         numeric(12,2) [not null]
}

Table order_addresses {
  id             uuid [pk]
  order_id       uuid [not null]
  website_id     uuid [not null]
  kind           address_kind [not null]
  recipient_name text [not null]
  phone          text [not null]
  line1          text [not null]
  line2          text [not null]
  city           text [not null]
  state          text [not null]
  pincode        text [not null]
  country        char(2) [not null]

  indexes { (order_id, kind) [unique] }
}

Table order_status_history {
  id          uuid [pk]
  order_id    uuid [not null]
  website_id  uuid [not null]
  from_status order_status
  to_status   order_status [not null]
  "note"      text
  actor_type  order_actor_type [not null]
  actor_id    uuid
  created_at  timestamptz [not null]

  Note: 'Append-only; no updated_at.'
}

// =============================================== payments and shipping ====

Table payments {
  id                  uuid [pk]
  order_id            uuid [not null]
  website_id          uuid [not null]
  payment_method_id   uuid
  method_type         payment_type [not null]
  provider            text [not null]
  provider_payment_id text
  method_label        text [not null]
  amount              numeric(12,2) [not null]
  fee                 numeric(12,2) [not null]
  status              payment_status [not null, default: 'pending']
  failure_reason      text
  authorized_at       timestamptz
  captured_at         timestamptz
  refunded_at         timestamptz
  provider_payload    jsonb [not null, note: 'redacted; never card data']
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]

  indexes {
    (provider, provider_payment_id) [unique]
    (id, website_id) [unique, name: 'uq_payments_id_website']
  }
}

Table refunds {
  id                 uuid [pk]
  payment_id         uuid [not null]
  website_id         uuid [not null]
  amount             numeric(12,2) [not null]
  reason             text
  status             refund_status [not null, default: 'pending']
  provider_refund_id text
  created_at         timestamptz [not null]
  updated_at         timestamptz [not null]
}

Table shipments {
  id                 uuid [pk]
  order_id           uuid [not null]
  website_id         uuid [not null]
  delivery_method_id uuid
  carrier            text [not null]
  awb                text
  tracking_url       text
  status             shipment_status [not null, default: 'processing']
  item_count         int [not null]
  failure_reason     text
  eta                timestamptz
  shipped_at         timestamptz
  delivered_at       timestamptz
  created_at         timestamptz [not null]
  updated_at         timestamptz [not null]

  indexes {
    (carrier, awb) [unique]
    (id, website_id) [unique, name: 'uq_shipments_id_website']
  }
}

Table shipment_events {
  id          uuid [pk]
  shipment_id uuid [not null]
  website_id  uuid [not null]
  code        shipment_event_code [not null]
  occurred_at timestamptz [not null]
  location    text [not null]
  "note"      text
  source      shipment_event_source [not null, default: 'carrier']
  created_at  timestamptz [not null]
}

// ================================================ reviews, subscriptions ====

Table reviews {
  id              uuid [pk]
  listing_id      uuid [not null]
  website_id      uuid [not null]
  website_user_id uuid
  order_id        uuid [note: 'verified purchase']
  author_name     text [not null]
  rating          smallint [not null]
  title           text [not null]
  body            text [not null]
  status          review_status [not null, default: 'pending']
  created_at      timestamptz [not null]
  updated_at      timestamptz [not null]

  Note: 'Partial unique (listing_id, website_user_id) WHERE website_user_id IS NOT NULL.'
}

Table newsletter_subscriptions {
  id              uuid [pk]
  website_id      uuid [not null]
  email           citext [not null]
  website_user_id uuid
  status          newsletter_status [not null, default: 'subscribed']
  source          text [not null]
  confirmed_at    timestamptz
  created_at      timestamptz [not null]
  updated_at      timestamptz [not null]

  indexes { (website_id, email) [unique] }
}

// ======================================================= audit and events ====

Table audit_events {
  id          uuid [pk]
  customer_id uuid
  website_id  uuid
  actor_type  actor_type [not null]
  actor_id    uuid [note: 'deliberately not a foreign key']
  actor_label text
  action      text [not null]
  entity_type text [not null]
  entity_id   uuid
  old_values  jsonb
  new_values  jsonb
  metadata    jsonb [not null]
  created_at  timestamptz [not null]

  Note: 'Written by application services, never by triggers.'
}

Table outbox_events {
  id             uuid [pk]
  aggregate_type text [not null]
  aggregate_id   uuid [not null]
  customer_id    uuid
  website_id     uuid
  event_type     text [not null]
  event_version  int [not null]
  payload        jsonb [not null]
  occurred_at    timestamptz [not null]
  published_at   timestamptz
  attempts       int [not null]
  last_error     text

  Note: 'Transactional outbox; a relay publishes to Redis Streams.'
}

// ============================================================ references ====
// Simple ownership
Ref: customer_access.customer_id - customers.id
Ref: dashboard_users.customer_id > customers.id
Ref: dashboard_refresh_tokens.dashboard_user_id > dashboard_users.id
Ref: dashboard_refresh_tokens.replaced_by_id - dashboard_refresh_tokens.id
Ref: dashboard_user_tokens.dashboard_user_id > dashboard_users.id
Ref: roles.customer_id > customers.id
Ref: dashboard_user_roles.role_id > roles.id
Ref: dashboard_user_roles.granted_by > dashboard_users.id
Ref: templates.id < template_versions.template_id
Ref: template_versions.id < template_pages.template_version_id
Ref: template_versions.id < template_sections.template_version_id
Ref: template_versions.id < template_page_sections.template_version_id
Ref: websites.customer_id > customers.id
Ref: websites.template_version_id > template_versions.id
Ref: media_assets.customer_id > customers.id
Ref: website_settings.website_id - websites.id
Ref: website_settings.favicon_media_id > media_assets.id
Ref: website_themes.website_id - websites.id
Ref: website_themes.logo_media_id > media_assets.id
Ref: website_pages.website_id > websites.id
Ref: website_pages.template_page_id > template_pages.id
Ref: website_sections.website_id > websites.id
Ref: website_sections.template_section_id > template_sections.id
Ref: site_versions.website_id > websites.id
Ref: site_versions.template_version_id > template_versions.id
Ref: site_versions.published_by > dashboard_users.id
Ref: website_users.avatar_media_id > media_assets.id
Ref: customer_auth_settings.customer_id - customers.id
Ref: customer_contact_details.customer_id - customers.id
Ref: storage_configs.customer_id - customers.id
Ref: payment_methods.customer_id > customers.id
Ref: delivery_methods.customer_id > customers.id
Ref: listing_categories.website_id > websites.id
Ref: listing_categories.image_media_id > media_assets.id
Ref: listings.website_id > websites.id
Ref: listing_images.media_asset_id > media_assets.id
Ref: carts.website_id > websites.id
Ref: coupons.website_id > websites.id
Ref: orders.delivery_method_id > delivery_methods.id
Ref: orders.payment_method_id > payment_methods.id
Ref: order_items.image_media_id > media_assets.id
Ref: payments.payment_method_id > payment_methods.id
Ref: shipments.delivery_method_id > delivery_methods.id
Ref: newsletter_subscriptions.website_id > websites.id
Ref: audit_events.customer_id > customers.id

// Scope-matched authorization (composite)
Ref: role_privileges.(role_id, scope) > roles.(id, scope)
Ref: role_privileges.(privilege_id, scope) > privileges.(id, scope)

// Tenant-pinned (composite) — a row cannot point at another tenant
Ref: dashboard_user_roles.(dashboard_user_id, customer_id) > dashboard_users.(id, customer_id)
Ref: dashboard_user_roles.(website_id, customer_id) > websites.(id, customer_id)
Ref: media_assets.(website_id, customer_id) > websites.(id, customer_id)
Ref: domains.(website_id, customer_id) > websites.(id, customer_id)
Ref: website_users.(website_id, customer_id) > websites.(id, customer_id)
Ref: website_auth_settings.(website_id, customer_id) > websites.(id, customer_id)
Ref: website_contact_details.(website_id, customer_id) > websites.(id, customer_id)
Ref: payment_method_websites.(payment_method_id, customer_id) > payment_methods.(id, customer_id)
Ref: payment_method_websites.(website_id, customer_id) > websites.(id, customer_id)
Ref: delivery_method_websites.(delivery_method_id, customer_id) > delivery_methods.(id, customer_id)
Ref: delivery_method_websites.(website_id, customer_id) > websites.(id, customer_id)
Ref: orders.(website_id, customer_id) > websites.(id, customer_id)

// Template version integrity (composite)
Ref: template_page_sections.(template_page_id, template_version_id) > template_pages.(id, template_version_id)
Ref: template_page_sections.(template_section_id, template_version_id) > template_sections.(id, template_version_id)

// Website-scoped ownership (composite)
Ref: websites.(published_version_id, id) - site_versions.(id, website_id)
Ref: website_sections.(website_page_id, website_id) > website_pages.(id, website_id)
Ref: website_user_identities.(website_user_id, website_id) > website_users.(id, website_id)
Ref: website_user_addresses.(website_user_id, website_id) > website_users.(id, website_id)
Ref: website_refresh_tokens.(website_user_id, website_id) > website_users.(id, website_id)
Ref: website_user_tokens.(website_user_id, website_id) > website_users.(id, website_id)
Ref: listing_variants.(listing_id, website_id) > listings.(id, website_id)
Ref: listing_images.(listing_id, website_id) > listings.(id, website_id)
Ref: listing_category_mappings.(listing_id, website_id) > listings.(id, website_id)
Ref: listing_category_mappings.(listing_category_id, website_id) > listing_categories.(id, website_id)
Ref: listing_inventory.(listing_variant_id, website_id) - listing_variants.(id, website_id)
Ref: cart_items.(cart_id, website_id) > carts.(id, website_id)
Ref: cart_items.(listing_variant_id, website_id) > listing_variants.(id, website_id)
Ref: carts.(website_user_id, website_id) > website_users.(id, website_id)
Ref: orders.(website_user_id, website_id) > website_users.(id, website_id)
Ref: order_items.(order_id, website_id) > orders.(id, website_id)
Ref: order_items.(listing_id, website_id) > listings.(id, website_id)
Ref: order_items.(listing_variant_id, website_id) > listing_variants.(id, website_id)
Ref: order_addresses.(order_id, website_id) > orders.(id, website_id)
Ref: order_status_history.(order_id, website_id) > orders.(id, website_id)
Ref: coupon_redemptions.(coupon_id, website_id) > coupons.(id, website_id)
Ref: coupon_redemptions.(order_id, website_id) > orders.(id, website_id)
Ref: payments.(order_id, website_id) > orders.(id, website_id)
Ref: refunds.(payment_id, website_id) > payments.(id, website_id)
Ref: shipments.(order_id, website_id) > orders.(id, website_id)
Ref: shipment_events.(shipment_id, website_id) > shipments.(id, website_id)
Ref: reviews.(listing_id, website_id) > listings.(id, website_id)
Ref: reviews.(website_user_id, website_id) > website_users.(id, website_id)
Ref: reviews.(order_id, website_id) > orders.(id, website_id)
Ref: newsletter_subscriptions.(website_user_id, website_id) > website_users.(id, website_id)

// ========================================================== table groups ====
TableGroup platform_identity {
  customers
  customer_access
  dashboard_users
  dashboard_refresh_tokens
  dashboard_user_tokens
  privileges
  roles
  role_privileges
  dashboard_user_roles
}

TableGroup templates_catalog {
  templates
  template_versions
  template_pages
  template_sections
  template_page_sections
}

TableGroup websites_content {
  websites
  website_settings
  website_themes
  website_pages
  website_sections
  site_versions
  media_assets
  domains
}

TableGroup website_users_auth {
  website_users
  website_user_identities
  website_user_addresses
  website_refresh_tokens
  website_user_tokens
  customer_auth_settings
  website_auth_settings
}

TableGroup org_configuration {
  customer_contact_details
  website_contact_details
  storage_configs
  payment_methods
  payment_method_websites
  delivery_methods
  delivery_method_websites
}

TableGroup commerce {
  listing_categories
  listings
  listing_variants
  listing_images
  listing_category_mappings
  listing_inventory
  carts
  cart_items
  coupons
  coupon_redemptions
  orders
  order_items
  order_addresses
  order_status_history
  payments
  refunds
  shipments
  shipment_events
  reviews
  newsletter_subscriptions
}

TableGroup audit_and_events {
  audit_events
  outbox_events
}
