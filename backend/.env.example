APP_NAME=ryugaware-api
APP_ENV=development
APP_VERSION=dev
APP_SHUTDOWN_TIMEOUT=20s
APP_PUBLIC_BASE_URL=http://localhost:3000

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_TRUSTED_PROXIES=

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_EXPOSED_HEADERS=X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12h

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ryugaware
POSTGRES_PASSWORD=ryugaware
POSTGRES_DB=ryugaware
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=1h
POSTGRES_CONN_MAX_IDLE_TIME=10m
POSTGRES_SLOW_QUERY_THRESHOLD=200ms
POSTGRES_STATEMENT_TIMEOUT=10s

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_KEY_PREFIX=ryugaware

STORAGE_PROVIDER=minio
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=ryugaware
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true
STORAGE_PRESIGN_EXPIRY=15m
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/svg+xml

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@ryugaware.local
SMTP_FROM_NAME=Ryugaware
SMTP_TLS_MODE=none
SMTP_INSECURE_SKIP_VERIFY=false
SMTP_TIMEOUT=10s

LOG_LEVEL=info
LOG_FORMAT=text
LOG_ADD_SOURCE=false

AUTH_TOKEN_HMAC_SECRET=change-me-openssl-rand-hex-32-0123456789abcdef
AUTH_JWT_ISSUER=ryugaware
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_BCRYPT_COST=12
AUTH_PASSWORD_RESET_TTL=1h
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=1m
AUTH_ROLES_CACHE_TTL=5m
AUTH_TENANT_KEY_CACHE_TTL=5m
AUTH_EMAIL_VERIFICATION_TTL=48h
AUTH_OTP_TTL=5m
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_RESEND_COOLDOWN=1m
AUTH_OTP_BLACKLIST_TTL=30m
AUTH_REGISTRATION_PROOF_TTL=3m
AUTH_COOKIE_DOMAIN=
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_NAME=Super admin

EVENTS_STREAM=ryugaware:events:v1
EVENTS_DLQ_STREAM=ryugaware:events:v1:dlq
EVENTS_STREAM_MAXLEN=100000
EVENTS_LIVE_CHANNEL=ryugaware:events:live
EVENTS_BATCH_SIZE=50
EVENTS_BLOCK_TIMEOUT=5s
EVENTS_MAX_RETRIES=3
EVENTS_CLAIM_MIN_IDLE=1m
EVENTS_CLAIM_INTERVAL=30s
EVENTS_HANDLER_TIMEOUT=30s
EVENTS_WORKERS_ENABLED=true
